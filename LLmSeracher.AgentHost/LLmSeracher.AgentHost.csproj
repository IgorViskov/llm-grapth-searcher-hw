<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\LLmSeracher.Core\LLmSeracher.Core.csproj" />
    <ProjectReference Include="..\LLmSeracher.Graph\LLmSeracher.Graph.csproj" />
  </ItemGroup>

  <!-- База знаний лежит в корне решения и копируется в вывод: один источник правды
       и для хоста агентов, и для локального режима консоли. -->
  <ItemGroup>
    <Content Include="..\knowledge\**\*.md" LinkBase="knowledge" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Тот же идентификатор, что у консольного клиента: ключ задаётся один раз
         и виден обоим процессам — хосту он нужен для агента-суммаризатора. -->
    <UserSecretsId>llmseracher-homework</UserSecretsId>
  </PropertyGroup>

</Project>
