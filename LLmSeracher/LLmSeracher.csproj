<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <UserSecretsId>llmseracher-homework</UserSecretsId>
        <RootNamespace>LLmSeracher.Cli</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
        <!-- Та же база знаний, что и у хоста: нужна для локального режима. -->
        <Content Include="..\knowledge\**\*.md" LinkBase="knowledge" CopyToOutputDirectory="PreserveNewest" />
        <Content Remove="..\knowledge\**" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.10" />
      <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
      <PackageReference Include="Spectre.Console" Version="0.57.2" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\LLmSeracher.Core\LLmSeracher.Core.csproj" />
    <ProjectReference Include="..\LLmSeracher.Graph\LLmSeracher.Graph.csproj" />
    </ItemGroup>

</Project>
